#include <iostream>
#include <vector>
#include <queue>
#include <climits>

using namespace std;

class Graph {
private:
    int V;                                // Number of vertices
    vector<vector<pair<int, int>>> adj;   // Adjacency list: stores {neighbor, weight}

public:
    // Constructor
    Graph(int vertices) {
        V = vertices;
        adj.resize(V);
    }

    // Function to add a weighted edge to the graph
    void addEdge(int u, int v, int weight) {
        adj[u].push_back({v, weight});
        adj[v].push_back({u, weight}); // Undirected graph
    }

    // Prim's Algorithm to find Minimum Spanning Tree
    void primMST() {
        // Priority queue to store {weight, vertex}
        // std::greater makes it a min-heap based on the weight
        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;

        vector<int> parent(V, -1);      // Stores the MST structure
        vector<int> key(V, INT_MAX);    // Minimum weights to connect vertices to MST
        vector<bool> inMST(V, false);   // Tracks vertices included in MST

        // Start with vertex 0
        int src = 0;
        pq.push({0, src});
        key[src] = 0;

        int totalWeight = 0;

        while (!pq.empty()) {
            int u = pq.top().second;
            pq.pop();

            // If vertex is already in MST, skip it
            if (inMST[u]) continue;

            inMST[u] = true; // Include vertex u in MST

            // If it's not the root node, add its edge weight to the total
            if (parent[u] != -1) {
                totalWeight += key[u];
            }

            // Traverse all adjacent vertices of u
            for (auto& neighbor : adj[u]) {
                int v = neighbor.first;
                int weight = neighbor.second;

                // If v is not in MST and the edge weight is smaller than current key of v
                if (!inMST[v] && weight < key[v]) {
                    key[v] = weight;
                    pq.push({key[v], v});
                    parent[v] = u;
                }
            }
        }

        // Print the edges of the MST and the total weight
        cout << "Edge \tWeight\n";
        for (int i = 1; i < V; ++i) {
            cout << parent[i] << " - " << i << " \t" << key[i] << "\n";
        }
        cout << "Total Weight of MST: " << totalWeight << endl;
    }
};

int main() {
    int V = 5;
    Graph g(V);

    // Adding weighted edges
    g.addEdge(0, 1, 2);
    g.addEdge(0, 3, 6);
    g.addEdge(1, 2, 3);
    g.addEdge(1, 3, 8);
    g.addEdge(1, 4, 5);
    g.addEdge(2, 4, 7);
    g.addEdge(3, 4, 9);

    cout << "Prim's Minimum Spanning Tree Result:\n";
    g.primMST();

    return 0;
}
